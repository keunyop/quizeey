# Local fixtures only. No secrets are needed for local development.
QUIZEEY_ENV=local
QUIZEEY_CONTENT_SOURCE=fixture
QUIZEEY_CANONICAL_ORIGIN=https://quizeey.com
# Optional local native forum. Start tools/modernization/test_database.py --serve first.
# This URL is only accepted for this isolated loopback fixture database.
# QUIZEEY_LOCAL_FORUM_DATABASE_URL=postgresql://quizeey_server@127.0.0.1:55432/quizeey_fixture
# QUIZEEY_LOCAL_FORUM_ORIGIN=http://127.0.0.1:3000
# Protected Vercel preview requires HTTP Basic credentials. Never NEXT_PUBLIC_*.
# QUIZEEY_PREVIEW_USER=
# QUIZEEY_PREVIEW_PASSWORD=
# Production remains blocked until real data, account and consent gates pass.
# Optional owner-private real-data review (loopback only; requires Basic credentials).
# QUIZEEY_CONTENT_SOURCE=local-archive
# QUIZEEY_LOCAL_CONTENT_FILE=D:/.../quizeey/.modernization/exports/source-265c3ca16e/local-content.json
# QUIZEEY_PREVIEW_USER=local-review
# QUIZEEY_PREVIEW_PASSWORD=
# local-archive is rejected in every hosted environment; source exports are excluded from deployment traces.
# Do not paste production DB credentials into this file or commit .env.local.
# Admin-only authentication: precreated users; no public signup or visitor Auth accounts.
# QUIZEEY_ADMIN_AUTH_PROVIDER=supabase
# QUIZEEY_SUPABASE_URL=https://tfkhnrbshvyfmrzxqfmq.supabase.co
# QUIZEEY_SUPABASE_PUBLISHABLE_KEY=
# QUIZEEY_ADMIN_USER_IDS=
# Keep these server-only. Empty configuration denies admin access.
# Hosted forum is disabled by default. Enable only after hosted HTTP/Auth/retention rehearsal.
# Public reads use the publishable key; privileged RPCs use a separate server-only key.
# QUIZEEY_SUPABASE_SECRET_KEY=
# QUIZEEY_FORUM_BACKEND=supabase
# QUIZEEY_TRUSTED_PROXY=vercel-direct
# QUIZEEY_ABUSE_HMAC_KEY=
# CRON_SECRET=
# Requires Supabase content, an actual Vercel process and a separate random HMAC key
# (32+ bytes base64url; different values for preview/production). Never NEXT_PUBLIC_*.
# Direct Vercel peer addressing requires Cloudflare DNS-only at cutover.
# Vercel system VERCEL_URL/VERCEL_BRANCH_URL determine preview write origins.
# Daily UTC cleanup uses a separate 32+ byte base64url CRON_SECRET. Verify its
# authenticated invocation and retention before enabling the hosted forum.
# See docs/modernization/hosted-rehearsal-plan.md before any cloud activation.
# Actual study preview: enable only after the approved upload and reconciliation.
# QUIZEEY_CONTENT_SOURCE=supabase
# QUIZEEY_CONTENT_DATASET_SHA256=88ed4da320cf3bbd40d65f1aa6de7ba6b81a09f5aa6bbcef1e3860ca58ccb42f
# Requires protected preview credentials and QUIZEEY_SUPABASE_SECRET_KEY.
# Existing GA4 web-stream ID goes here in Vercel; no new Analytics property is needed.
# QUIZEEY_GA4_MEASUREMENT_ID=
# Production ads/analytics also require verified account consent and canonical-host activation.
# QUIZEEY_CMP_SCRIPT_URL=
# QUIZEEY_ADS_VERIFIED=false
# QUIZEEY_RELEASE_READY=false
# Protected production configuration checks before consent/live approval:
# QUIZEEY_PRODUCTION_REVIEW=true
# Requires Production secrets. Basic protection covers every host, robots block all,
# sitemap is empty and ads/analytics are disabled. Cannot be release-ready.
# The final live build requires review=false plus existing release/ads/consent gates.
